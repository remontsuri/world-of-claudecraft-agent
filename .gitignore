# ============================================================
# world-of-claudecraft-agent — .gitignore
# Переписан 2026-09-18: раньше сюда был скопирован список чужого
# проекта (игры) — ~100 строк про electron/, release-steam/, sfx-runtime/,
# discord_bot_info.txt и т.п., которых в этом репозитории никогда не было.
# Оставлено только то, что реально может появиться здесь.
# ============================================================

# --- Java-сборка woof-agent (javac без Maven) ---
woof-agent/build/
*.class

# --- Python (архив fly-линии и два клиента моста в корне) ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- Node (инструменты и эталоны моста) ---
node_modules/

# --- линия woof-ts (активная): собираемое не коммитим, дерево игры — ссылка ---
# dist/         — бандл агента (esbuild), воспроизводится `npm run build`;
# dist-env/     — бандл headless env server upstream (tools/build_env.sh), 6.8 МБ;
# game          — симлинк на чекаут игры (tools/setup_game.sh), не содержимое;
# node_modules  — стирается в песочнице каждый ход, ставится setup-скриптом.
# evidence/ и learning/ — НАПРОТИВ, отслеживаются: это доказательства прогонов
# и история самоулучшения, их потеря обесценивает результаты.
woof-ts/dist/
woof-ts/dist-env/
woof-ts/game
# Черновики подбора порогов: десятки evidence-файлов на каждый раунд тюнинга.
# Итог подбора отслеживается (learning/best.json, history.jsonl, last_report.md).
woof-ts/evidence/tuning/

# --- логи, рантайм-состояние агента, временные файлы ---
*.log
/logs/
tmp/
.hermes-tmp.*
*.pid
*.lock
bridge_pid.txt
bridge_err.log
bridge_out.log
bridge_run.log
nul
.DS_Store
Thumbs.db

# --- секреты и окружение ---
.env
.env.*
!.env.example
AuthKey_*.p8
*.pem
*.key
id_rsa
credentials
.git-credentials
.netrc

# --- редакторы и агенты ---
.idea/
.vscode/
.cursor/
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
.claude-scratch/
.codex-research/
.playwright-mcp/
.worktrees/
screenshots/
pr-shots*/
pr.diff

# --- отладочные артефакты агента (неотслеживаемые _*.py, _*.cjs, _*.json) ---
_*.py
_*.cjs
_*.ps1
_*.png
_*.json
_*.tmp
_snap*.json
.rb_*.tmp

# --- тяжёлые данные: в репозиторий не кладутся ---
# LFS исчерпан; файлы >100 МБ — только в Releases.
*.tar.gz
*.zip
*.feather
*.pkl

# ============================================================
# Архив fly-линии: КОД, ДОКУМЕНТАЦИЯ И ДОКАЗАТЕЛЬСТВА — в git,
# ТЯЖЁЛЫЕ ДАННЫЕ — нет (2026-09-18, решение владельца).
#
# Снято с отслеживания (~108 МБ из 117):
#   * три копии коннектома + контроль ER        (archive/fly-line/data/)
#   * каноническая схема circuit.json, 26 МБ    (…/fly-woc/data/circuit.json)
#   * чек-инты читаута *.pt                     (…/fly-woc/outputs/)
#   * сцена визуализации scene-full.json, 0.9 МБ (…/fly-woc/viz/)
#   * circuit_full.json (никогда не коммитился)
#
# Как вернуть файл:  git checkout 40f3ba6 -- <путь>
# Как воспроизвести: контроли rewired/er regenerable из канона за 18 с —
#   python3 archive/fly-line/fly-woc/tools/make_control_graph.py \
#       --in <circuit.json> --out <…> --mode er|degree --seed 1
#   (проверено 2026-09-18: результат идентичен закоммиченному по всем полям)
#   канон собирается build_circuit.py из данных MaleCNS (CC BY 4.0),
#   хеши исходников — в …/fly-woc/data/manifest.json.
#
# Таблицы квестов (4 × ~80 КБ), benchmark_*.json (3.7 МБ, числа F8),
# train_log_*.json (конфигурации прогонов) и весь код/доки — ОСТАЮТСЯ в git:
# это доказательства, а не веса.
# ============================================================
archive/fly-line/data/circuit_er.json
archive/fly-line/data/circuit_rewired.json
archive/fly-line/data/circuit_full.json
archive/fly-line/data/circuit-full/circuit.json
archive/fly-line/fly-woc/data/circuit.json
archive/fly-line/fly-woc/data/circuit_full.json
archive/fly-line/fly-woc/outputs/*.pt
archive/fly-line/fly-woc/viz/scene-full.json

# Отрицания: шаблоны выше/выше по списку не должны ловить нужные файлы.
# `_*.py` (отладочные артефакты агента) совпадает с `__init__.py`, а `*.log` —
# с логами-доказательствами в архиве. Оба найдены проверкой 2026-09-18:
# git ls-files | git check-ignore --stdin  (после git rm --cached)
!__init__.py
!archive/fly-line/reference/*.log
