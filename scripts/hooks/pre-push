#!/bin/bash
# Pre-push hook: verify AGENTS.md is updated when agent code changes

set -e

# Get the remote and URL
REMOTE="$1"
URL="$2"

# Get list of commits being pushed
COMMITS=$(git rev-list --no-walk HEAD 2>/dev/null || git rev-list HEAD)

AGENTS_STAGED=false
AGENT_CODE_PUSHED=false

# Check if AGENTS.md is in the push
if git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -q "AGENTS.md"; then
  AGENTS_STAGED=true
fi

# Check if agent code is in the push
if git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -qE "(python/.*\.py|woof-agent/)"; then
  AGENT_CODE_PUSHED=true
fi

# Warn but don't block if agent code pushed without AGENTS.md update
if [ "$AGENT_CODE_PUSHED" = true ] && [ "$AGENTS_STAGED" = false ]; then
  echo "[hook] WARNING: Agent code changed but AGENTS.md not updated in this push"
  echo "[hook] Consider running: git add AGENTS.md && git commit --amend"
fi

exit 0
