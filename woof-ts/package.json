{
  "name": "woof-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "\u0410\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u044b\u0439 \u0430\u0433\u0435\u043d\u0442 World of Claudecraft \u043d\u0430 TypeScript: \u043c\u0438\u0440 \u2014 headless src/sim upstream, \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u2014 \u043a\u0430\u043d\u043e\u043d ACTIONS",
  "scripts": {
    "setup": "bash tools/setup_game.sh",
    "build": "esbuild src/run.ts --bundle --platform=node --format=esm --outfile=dist/run.mjs --log-level=warning && esbuild src/learn/tune.ts --bundle --platform=node --format=esm --outfile=dist/tune.mjs --log-level=warning",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "bash tools/check_all.sh",
    "tune": "node dist/tune.mjs"
  },
  "dependencies": {
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
